# Branding and public pages
APP_NAME=Smart Learning Lab 247
INSTAGRAM_PAGES=https://www.instagram.com/smartlearninglab247,https://www.instagram.com/cgl_ssc_railway_rpsc_bank
FACEBOOK_PAGE_URL=https://www.facebook.com/smartlearninglab247
EDUAPPNAME=https://smartlearninglab-react.pages.dev/

# YouTube OAuth 2.0
# Create an OAuth client in Google Cloud and use the one-time
# scripts/get_youtube_refresh_token.py helper to obtain the refresh token.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# public | private | unlisted
YOUTUBE_PRIVACY_STATUS=public
# 27 = Education
YOUTUBE_CATEGORY_ID=27
YOUTUBE_MADE_FOR_KIDS=false
YOUTUBE_LANGUAGE=en
YOUTUBE_DEFAULT_TAGS=smart learning lab 247,quiz,competitive exams,ssc,upsc,banking,railway,ras,ias,gk,mock test

# Video settings
TTS_VOICE=en-IN-NeerjaNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
COUNTDOWN_SECONDS=3
POST_AUDIO_WAIT_SECONDS=3
ANSWER_SLIDE_DURATION=3
BACKGROUND_VOLUME=0.30
TICK_VOLUME=0.80
CORRECT_VOLUME=1.00
PAGE_URL=https://smartlearninglab-react.pages.dev/
